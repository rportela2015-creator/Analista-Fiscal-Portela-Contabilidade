# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - CLASSIFICADOR DE NCM + AUDITORIA E PRECIFICAÇÃO
# Aplicativo_MCM- · Portela Contabilidade
# ==============================================================================

# --- SEGURANÇA E ATUALIZAÇÃO ---
# Habilita a rota administrativa POST /api/atualizar ('true' para habilitar, 'false' por padrão)
ENABLE_UPDATE_ROUTE=false

# Token secreto exigido no cabeçalho 'Authorization: Bearer <UPDATE_TOKEN>' para disparar atualização
UPDATE_TOKEN=insira_aqui_seu_token_secreto_super_seguro

# Origens permitidas para carregar o aplicativo em iframes (CSP frame-ancestors além de 'self')
# Exemplo: https://erp.portelacontabilidade.com.br https://app.meudominio.com
FRAME_ANCESTORS=

# --- INTELIGÊNCIA ARTIFICIAL LOCAL (SOBERANA - OLLAMA / GPU RX 580) ---
# Modo de soberania:
# - 'local_first': Tenta Ollama local primeiro; se offline, faz fallback para nuvem (Gemini)
# - 'local_strict': Modo Soberano Estrito. Bloqueia qualquer envio de dados fiscais/NF-e para nuvem
AI_SOVEREIGNTY_MODE=local_first

# Endereço do servidor Ollama local (executando com GPU AMD RX 580 / ROCm / Vulkan)
OLLAMA_HOST=http://127.0.0.1:11434

# --- INTELIGÊNCIA ARTIFICIAL EM NUVEM (FALLBACK GOOGLE GEMINI) ---
# Chave da API do Google AI Studio (Gemini) para fallback quando Ollama local não responder
GEMINI_API_KEY=

# Modelos Gemini ordenados por prioridade (separados por vírgula)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash

# --- AMBIENTE DE EXECUÇÃO ---
NODE_ENV=development
